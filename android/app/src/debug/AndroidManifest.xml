<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds talk to a local backend over plain HTTP. Release builds do
         not get this, so cleartext stays blocked in production. -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">
        <activity android:name=".MainActivity">
            <!-- busauth://localhost/... used by the local auth flow. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="busauth" android:host="localhost"/>
            </intent-filter>
            <!-- Emulator loopback for the dev server. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http" android:host="localhost"/>
                <data android:scheme="http" android:host="10.0.2.2"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
