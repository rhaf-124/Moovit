<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the OS starts the process, before the Flutter engine draws
         its first frame. -->
    <style name="LaunchTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applied once the process has started; also the window background behind
         the Flutter UI for the life of the activity. -->
    <style name="NormalTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
